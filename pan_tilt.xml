<mujoco model="pan_tilt_event_cam">
  <compiler angle="degree"/>
  <option gravity="0 0 -9.81"/>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.2 0.2 0.2" rgb2="0.8 0.8 0.8"
              width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="3 3" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" diffuse="1 1 1" directional="true"/>

    <!-- back wall the camera looks at: textured + a few high-contrast objects -->
    <geom name="wall" type="box" pos="2 0 1" size="0.02 2 1.5" material="grid_mat"/>
    <geom name="target1" type="sphere" pos="1.98 0.6 1.3" size="0.15" rgba="1 0 0 1"/>
    <geom name="target2" type="box"    pos="1.98 -0.5 0.7" size="0.05 0.15 0.15" rgba="0 1 0 1"/>
    <geom name="target3" type="cylinder" pos="1.98 0.0 0.4" size="0.12 0.12" rgba="0.1 0.3 1 1"/>

    <!-- pan-tilt rig -->
    <body name="pan_link" pos="-2 0 1">
      <joint name="pan_joint" type="hinge" axis="0 0 1" range="-90 90"/>
      <geom type="cylinder" size="0.03 0.05" rgba="0.3 0.3 0.3 1"/>

      <body name="tilt_link" pos="0 0 0.05">
        <joint name="tilt_joint" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom type="box" size="0.04 0.04 0.02" rgba="0.5 0.5 0.5 1"/>
        <camera name="event_cam" pos="0.05 0 0" euler="0 -90 0" fovy="55"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="pan_act"  joint="pan_joint"  kp="20"/>
    <position name="tilt_act" joint="tilt_joint" kp="20"/>
  </actuator>
</mujoco>
